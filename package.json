{
  "name": "@anfilat/bit-by-bit",
  "version": "0.2.0",
  "description": "Step-by-step task management for Pi — splits LLM output into isolated task branches",
  "author": "Andrey Filatkin",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "typecheck": "tsc --noEmit",
    "extraction:compare": "jiti extraction-check/compare.ts",
    "extraction:update": "jiti extraction-check/compare.ts --update"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "jiti": "^2.7.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "simple-git-hooks": {
    "pre-commit": "npx oxfmt --check src/ test/ && npx oxlint src/ && npx vitest run"
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anfilat/bit-by-bit.git"
  },
  "homepage": "https://github.com/anfilat/bit-by-bit#readme",
  "bugs": {
    "url": "https://github.com/anfilat/bit-by-bit/issues"
  },
  "license": "MIT"
}
